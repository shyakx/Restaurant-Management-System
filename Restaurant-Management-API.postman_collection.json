		{
			"name": "🛒 Order Management - Complete CRUD",
			"description": "Full order lifecycle management with email notifications",
			"item": [
				{
					"name": "Create Order - Email Test",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store order ID for later tests",
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set('test_order_id', pm.response.json().id);",
									"    pm.collectionVariables.set('test_customer_email', pm.response.json().customerEmail);",
									"    console.log('Order created with ID:', pm.response.json().id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerName\": \"{{customer_name}}\",\n  \"customerEmail\": \"{{customer_email}}\",\n  \"customerPhone\": \"{{customer_phone}}\",\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"menuItemId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/api/orders"
					},
					"description": "Creates new order and triggers immediate email confirmation"
				},
