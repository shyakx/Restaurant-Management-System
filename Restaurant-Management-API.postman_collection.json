							"mode": "raw",
							"raw": "{\n  \"customerName\": \"Workflow Test\",\n  \"customerEmail\": \"{{customer_email}}\",\n  \"customerPhone\": \"+1234567890\",\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"quantity\": 1\n    }\n  ]\n}",
