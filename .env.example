# Database Configuration
POSTGRES_DB=restaurant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email Configuration
# Use Gmail App Password: https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Configuration
KAFKA_HOST=localhost
KAFKA_PORT=9092
ZOOKEEPER_HOST=localhost
ZOOKEEPER_PORT=2181

# Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
ORDER_SERVICE_PORT=8082
KITCHEN_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Service URLs (Docker)
EUREKA_SERVER_URL=http://eureka-server:8761/eureka
ORDER_SERVICE_URL=http://order-service:8082
KITCHEN_SERVICE_URL=http://kitchen-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# Service URLs (Local)
EUREKA_SERVER_URL_EXTERNAL=http://localhost:8761/eureka
API_GATEWAY_URL_EXTERNAL=http://localhost:8081
ORDER_SERVICE_URL_EXTERNAL=http://localhost:8082
KITCHEN_SERVICE_URL_EXTERNAL=http://localhost:8083
NOTIFICATION_SERVICE_URL_EXTERNAL=http://localhost:8084

# Settings
SPRING_PROFILES_ACTIVE=local-dev

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE=30s
CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10

# Database Pool
DATABASE_MAX_POOL_SIZE=20
DATABASE_MIN_IDLE=5
DATABASE_IDLE_TIMEOUT=300000

# HTTP
HTTP_CONNECT_TIMEOUT=5000
HTTP_RESPONSE_TIMEOUT=30s
HTTP_MAX_CONNECTIONS=500
HTTP_ACQUIRE_TIMEOUT=10000

# Retry
GATEWAY_RETRY_COUNT=3
KAFKA_RETRY_COUNT=3
